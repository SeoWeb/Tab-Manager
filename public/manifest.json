{
  "manifest_version": 3,
  "name": "TabSpace",
  "version": "0.1.0",
  "description": "A Chrome extension for managing tabs and bookmarks.",
  "permissions": ["storage", "tabs", "bookmarks", "activeTab", "alarms"],
  "host_permissions": [
    "https://tab-manager-backend.ww0.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "TabSpace"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
