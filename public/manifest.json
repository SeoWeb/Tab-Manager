{
  "manifest_version": 3,
  "name": "Tab Manager (Next.js)",
  "version": "0.1.0",
  "description": "A Chrome extension for managing tabs and bookmarks, built with Next.js.",
  "permissions": ["storage", "tabs", "bookmarks", "activeTab"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Tab Manager"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
