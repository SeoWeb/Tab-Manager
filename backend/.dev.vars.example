# Copy this file to `.dev.vars` and fill in real values for local development.
# `.dev.vars` is gitignored and read automatically by `wrangler dev`.

# Required: any long random string used to sign and verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Enable the POST /auth/demo endpoint for local testing. Keep false in production.
ENABLE_DEMO_AUTH=true

# Optional: comma-separated origins allowed by CORS. Defaults to "*" when omitted.
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5173
